# Public example configuration for local development.
# Copy this file to .env and adjust values for your own environment.

VITE_VERSION=3.0.2
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false

# Demo-only key used by the client-side screen-lock feature.
# VITE_* variables are exposed to the browser; never put real secrets here.
VITE_LOCK_ENCRYPT_KEY=demo-public-key-change-me

# API configuration. Replace with your own backend or mock endpoint.
VITE_API_URL=/
VITE_API_PROXY_URL=https://example.com/api
VITE_DROP_CONSOLE=false
